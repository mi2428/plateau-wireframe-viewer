<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic inline geometry + dependencies generated by the LAS/LAZ worker. LAS and LAZ overlap deliberately. -->
<core:CityModel xmlns:core="http://www.opengis.net/citygml/2.0" xmlns:gml="http://www.opengis.net/gml"
  xmlns:gen="http://www.opengis.net/citygml/generics/2.0" xmlns:uro="https://www.geospatial.jp/iur/uro/3.2">
  <gml:boundedBy><gml:Envelope srsName="EPSG:4326" srsDimension="3"><gml:lowerCorner>35 135 -4</gml:lowerCorner><gml:upperCorner>35.0004 135.00025 28</gml:upperCorner></gml:Envelope></gml:boundedBy>
  <core:cityObjectMember><gen:GenericCityObject gml:id="original-line-and-point"><gen:lod1Geometry><gml:MultiGeometry>
    <gml:geometryMember><gml:Point><gml:pos>35 135 -4</gml:pos></gml:Point></gml:geometryMember>
    <gml:geometryMember><gml:LineString><gml:posList>35 135 -4 35.0002 135.0001 13 35.0004 135.00025 28</gml:posList></gml:LineString></gml:geometryMember>
  </gml:MultiGeometry></gen:lod1Geometry></gen:GenericCityObject></core:cityObjectMember>
  <core:cityObjectMember><gen:GenericCityObject gml:id="dependent-las"><uro:pointCloud><uro:PointCloud>
    <uro:lod>1</uro:lod><uro:pointFile>../point-cloud/cloud7.las</uro:pointFile><uro:pointFileSrsName>EPSG:4326</uro:pointFileSrsName>
  </uro:PointCloud></uro:pointCloud></gen:GenericCityObject></core:cityObjectMember>
  <core:cityObjectMember><gen:GenericCityObject gml:id="dependent-laz"><uro:pointCloud><uro:PointCloud>
    <uro:lod>1</uro:lod><uro:pointFile>../point-cloud/cloud7.laz</uro:pointFile>
  </uro:PointCloud></uro:pointCloud></gen:GenericCityObject></core:cityObjectMember>
</core:CityModel>
