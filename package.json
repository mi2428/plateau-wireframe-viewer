{
  "name": "plateau-wireframe-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-decoders.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/copy-decoders.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "precheck": "node scripts/copy-decoders.mjs",
    "check": "node --test test/*.test.mjs",
    "check:browser": "node test/integration-browser.mjs"
  },
  "dependencies": {
    "@voxelkloud/wasm-codecs": "0.5.1",
    "3d-tiles-renderer": "0.5.3",
    "cdt2d": "1.0.0",
    "copc": "0.0.9",
    "proj4": "2.22.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "draco3d": "1.5.7",
    "meshoptimizer": "1.3.0",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
